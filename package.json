{
  "name": "cfengine-policy-builder",
  "version": "0.1.0",
  "description": "CFEngine Policy Builder - visual CFEngine policy builder (Electron + React)",
  "author": "Northern.tech",
  "license": "SEE LICENSE IN LICENSE",
  "main": "./out/main/index.js",
  "private": true,
  "prettier": "@northern.tech/prettier-config/react.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev --watch",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "build:unpack": "npm run package:prepare && electron-builder --dir",
    "build:mac": "npm run package:prepare && electron-builder --mac",
    "build:win": "npm run package:prepare && electron-builder --win",
    "build:linux": "npm run package:prepare && electron-builder --linux",
    "package:prepare": "npm run backend:build && npm run build",
    "backend:sync": "uv sync --directory python",
    "backend:build": "uv run --directory python --group build pyinstaller --noconfirm cfpb-backend.spec",
    "backend:test": "uv run --directory python pytest",
    "backend:format": "uv run --directory python black .",
    "backend:format:check": "uv run --directory python black --check .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/red-hat-text": "^5.3.0",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.2.0",
    "@northern.tech/themes": "^0.16.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@northern.tech/eslint-config": "^0.7.1",
    "@northern.tech/prettier-config": "^0.2.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "globals": "^17.8.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
